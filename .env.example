LANGCHAIN_API_KEY=replace-with-your-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=kopi-and-keys

# Match the LangSmith API region to the account where the key was created.
# For an APAC account, uncomment:
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# Optional separate policy model, after downloading it with setup_ollama.ps1 -Model qwen3:4b.
# Leave unset to use the existing qwen2.5:3b model for policy and price summaries.
# KOPI_POLICY_MODEL=qwen3:4b
