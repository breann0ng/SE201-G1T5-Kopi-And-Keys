# Copy to .env and fill in locally. Never commit .env.

# --- Model (Advisor) ---
OLLAMA_BASE_URL=http://localhost:11434
ADVISOR_MODEL=qwen3:8b          # example tag; set to the team's chosen model
EMBEDDING_MODEL=embeddinggemma

# --- Data paths (relative to repo root) ---
RESALE_DB_PATH=data/processed/resale.db
CHROMA_PATH=data/chroma
POLICY_SOURCES_PATH=policy/sources.yaml

# --- Optional tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kopi-and-keys
