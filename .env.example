LANGCHAIN_API_KEY=replace-with-your-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=kopi-and-keys

# Match the LangSmith API region to the account where the key was created.
# For an APAC account, uncomment:
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# Optional separate policy model, after downloading it with setup_ollama.ps1 -Model qwen3:4b.
# Leave unset to use the existing qwen2.5:3b model for policy and price summaries.
# KOPI_POLICY_MODEL=qwen3:4b

# Optional GPU allocation: set only when Ollama runs on an allocated GPU node.
# CPU remains the default. GPU mode lets Ollama select scheduler-visible devices.
# KOPI_OLLAMA_DEVICE=gpu
# For a model server reached through an SSH tunnel on local port 11435:
# KOPI_OLLAMA_BASE_URL=http://127.0.0.1:11435

# Finals: minimum deterministic policy quote relevance (0 < value <= 1).
# This is a lexical coverage score, not a confidence probability. Default: 0.20.
# KOPI_POLICY_MIN_RELEVANCE=0.20

# CPU threads for the local model. 8 measured ~35% faster than the default 4 on an
# i7-1255U (2 performance + 8 efficiency cores); try about your core count. Plug in the
# charger and use Windows "Best performance" power mode, or the CPU is throttled.
# KOPI_OLLAMA_NUM_THREADS=8

# Added 2026-10-17: waiting time.
# How long Ollama keeps the model loaded after a question ("-1" = until Ollama stops).
# Reloading costs 10-20 s, so the first question after a quiet spell is slower.
KOPI_OLLAMA_KEEP_ALIVE=30m
# Load the model when the backend starts (0 = don't).
KOPI_WARM_UP=1
# Answers to repeated questions kept in memory (same question, profile, history and snapshot).
# Cleared on restart; 0 turns it off.
KOPI_RESPONSE_CACHE=200
