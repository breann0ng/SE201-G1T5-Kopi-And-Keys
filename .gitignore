# Local Python environment and generated Python files
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Local secrets and environment configuration
.env
.env.*
!.env.example

# Imported and generated application data
data/raw/*
# Exception: the team's shared resale snapshot (data.gov.sg, downloaded 2026-10-14).
!data/raw/2017-onwards-resale-prices.csv
data/processed/
data/chroma/
*.sqlite
*.sqlite3
*.db

# Runtime output and local-only configuration
logs/
.local/

# Folder under data. Held-out evaluation questions/data must not be committed
held-out/

# Safety net: no file named *heldout* is committed (held-out questions live outside the
# repo; see docs/heldout-guide.md). Already-tracked files, such as the retired draft in
# data/evaluation-data/development/archive/, are not affected.
*heldout*
!docs/heldout-guide.md
